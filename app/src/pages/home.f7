  color: #999ba6;
  font-size: 13px;
}

/* Adaptación del diseño para pantallas pequeñas. */
@media (max-width: 700px) {
  .mt-container {
    padding: 27px 16px;
  }

  .mt-welcome {
    align-items: flex-start;
