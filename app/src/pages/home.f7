}

.mt-cover-image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: top center;
  border-radius: 8px;
}

/* Información que aparece junto a cada portada. */
.mt-card-info {
  display: flex;
  flex: 1;
