<template>
  <div class="page mt-page" data-name="home">

    <!-- Encabezado principal de MangaTracker. -->
    <div class="navbar mt-navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="mt-brand">
          <span class="mt-logo">M</span>
          <span>MangaTracker</span>
        </div>
        <div class="mt-navbar-label">MY READING SPACE</div>
      </div>
    </div>

    <div class="page-content mt-content">
      <div class="mt-container">

        <!-- Bienvenida y acceso al formulario para agregar mangas. -->
        <section class="mt-welcome">
          <div>
            <div class="mt-eyebrow">TU BIBLIOTECA PERSONAL</div>
            <h1>Mi colección</h1>
            <p>Organizá tus lecturas y llevá el control de tus mangas.</p>
          </div>

          <a href="/add-manga/" class="button mt-add-button">
            <span class="mt-plus">+</span>
            Agregar manga
          </a>
        </section>

        <!-- Resumen de la cantidad de mangas por estado. -->
        <section class="mt-stats">
          <div class="mt-stat-card">
            <span class="mt-stat-label">TOTAL DE MANGAS</span>
            <strong>${mangas.length}</strong>
            <span class="mt-stat-detail">En tu biblioteca</span>
          </div>

          <div class="mt-stat-card">
            <span class="mt-stat-label">LEYENDO</span>
            <strong>${mangas.filter(manga => manga.status === 'Leyendo').length}</strong>
            <span class="mt-stat-detail">Lecturas activas</span>
          </div>

          <div class="mt-stat-card">
            <span class="mt-stat-label">COMPLETADOS</span>
            <strong>${mangas.filter(manga => manga.status === 'Completado').length}</strong>
            <span class="mt-stat-detail">Historias terminadas</span>
          </div>
        </section>

        <!-- Biblioteca: muestra tarjetas dinámicas con los mangas guardados. -->
        <section class="mt-library">
          <div class="mt-section-heading">
            <div>
              <h2>Mis mangas</h2>
              <p>Tu colección personal</p>
            </div>
            <span class="mt-total">${mangas.length} registros</span>
          </div>

          <!-- Si no hay mangas, muestra un mensaje; si hay, recorre la lista. -->
          <div class="mt-manga-grid">
            ${
              mangas.length === 0
                ? $h`
                  <div class="mt-empty">
                    <div class="mt-empty-symbol">M</div>
                    <h3>Tu biblioteca está vacía</h3>
                    <p>Agregá tu primer manga para comenzar.</p>
                  </div>
                `
                : mangas.map((manga) => $h`
                  <article class="mt-card">

                    <!-- Selecciona una portada según el título del manga. -->
                    
                    ${
                      manga.cover
                        ? $h`
                          <div class="mt-cover mt-cover-image">
                            <img
                              src="${manga.cover}"
                              alt="Portada de ${manga.title}"
                            />
                          </div>
                        `
                        : (manga.title || '').trim().toLowerCase() === 'one piece'
                          ? $h`
                            <div class="mt-cover mt-cover-image">
                              <img
                                src="/images/one-piece-vol1.jpg"
                                alt="Portada de One Piece"
                              />
                            </div>
                          `
                          : (manga.title || '').trim().toLowerCase() === 'gintama'
                            ? $h`
                              <div class="mt-cover mt-cover-image">
                                <img
                                  src="/images/gintama-vol1.jpg"
                                  alt="Portada de Gintama"
                                />
                              </div>
                            `
                            : $h`
                              <div class="mt-cover">
                                <span class="mt-cover-top">MANGATRACKER</span>
                                <span class="mt-cover-initial">
                                  ${manga.title ? manga.title.charAt(0).toUpperCase() : 'M'}
                                </span>
                                <span class="mt-cover-bottom">MY COLLECTION</span>
                              </div>
                            `
                    }


                    <!-- Información del manga y botones de administración. -->
                    <div class="mt-card-info">
                      <div class="mt-card-title">${manga.title}</div>

                      <div class="mt-chapter">
                        Capítulo actual: <strong>${manga.chapter}</strong>
                      </div>

                      <!-- El color cambia según el estado de lectura. -->
                      <span class="mt-status ${
                        manga.status === 'Leyendo'
                          ? 'is-reading'
                          : manga.status === 'Completado'
                            ? 'is-completed'
                            : 'is-pending'
                      }">
                        ${manga.status}
                      </span>

                      <div class="mt-card-actions">

                        <!-- Permite modificar el capítulo actual. -->
                        <button
                          type="button"
                          class="button mt-action-button"
                          @click="${() => editChapter(manga)}"
                        >
                          Editar capítulo
                        </button>

                        <!-- Permite cambiar el estado de lectura. -->
                        <button
                          type="button"
                          class="button mt-action-button"
                          @click="${() => changeStatus(manga)}"
                        >
                          Cambiar estado
                        </button>

                        <!-- Permite eliminar el manga de la biblioteca. -->
                        <button
                          type="button"
                          class="button mt-delete-button"
                          @click="${() => removeManga(manga)}"
                        >
                          Eliminar
                        </button>

                        <!-- Despliega la ficha completa sin salir de la biblioteca. -->
                        <button
                          type="button"
                          class="button mt-action-button mt-details-button"
                          @click="${() => toggleDetails(manga)}"
                        >
                          ${expandedMangaId === manga.id ? 'Ocultar detalles' : 'Ver detalles'}
                        </button>

                        <!-- Permite modificar los datos descriptivos del manga. -->
                        <button
                          type="button"
                          class="button mt-action-button"
                          @click="${() => editMangaDetails(manga)}"
                        >
                          Editar ficha
                        </button>
                      </div>
                    </div>

                    <!-- Ficha ampliada con portada, autor, género y sinopsis. -->
                    ${
                      expandedMangaId === manga.id
                        ? $h`
                          <div class="mt-detail-panel">
                            <div class="mt-detail-cover">
                              ${
                                getMangaCover(manga)
                                  ? $h`
                                    <img
                                      src="${getMangaCover(manga)}"
                                      alt="Portada de ${manga.title}"
                                    />
                                  `
                                  : $h`
                                    <div class="mt-detail-placeholder">
                                      ${manga.title ? manga.title.charAt(0).toUpperCase() : 'M'}
                                    </div>
                                  `
                              }
                            </div>

                            <div class="mt-detail-content">
                              <div class="mt-detail-heading">Ficha del manga</div>

                              <div class="mt-detail-field">
                                <span>Autor</span>
                                <strong>${manga.author || 'No especificado'}</strong>
                              </div>

                              <div class="mt-detail-field">
                                <span>Género</span>
                                <strong>${manga.genre || 'No especificado'}</strong>
                              </div>

                              <div class="mt-detail-field mt-detail-synopsis">
                                <span>Sinopsis</span>
                                <p>${manga.synopsis || 'Todavía no se ha agregado una sinopsis para este manga.'}</p>
                              </div>
                            </div>
                          </div>
                        `
                        : ''
                    }
                  </article>
                `)
            }
          </div>
        </section>

      </div>
    </div>
  </div>
</template>

<script>
// Funciones para leer, actualizar y eliminar mangas del almacenamiento local.
import {
  getMangas,
  updateManga,
  deleteManga
} from '../js/manga-storage.js';

export default (props, { $f7, $update, $on }) => {

  // Carga los mangas guardados cuando se abre la pantalla.
  let mangas = getMangas();

  // Guarda el identificador del manga cuya ficha está desplegada.
  let expandedMangaId = null;

  // Devuelve la portada correspondiente al manga.
  const getMangaCover = (manga) => {
    if (manga.cover) return manga.cover;

    const title = (manga.title || '').trim().toLowerCase();

    if (title === 'one piece') return '/images/one-piece-vol1.jpg';
    if (title === 'gintama') return '/images/gintama-vol1.jpg';

    return '';
  };

  // Abre o cierra la ficha detallada de una tarjeta.
  const toggleDetails = (manga) => {
    expandedMangaId =
      expandedMangaId === manga.id ? null : manga.id;

    $update();
  };

  // Vuelve a leer la biblioteca y actualiza la pantalla.
  const refreshMangas = () => {
    mangas = getMangas();
    $update();
  };

  // Permite editar el autor, el género y la sinopsis de un manga.
  // Los datos se actualizan en localStorage sin borrar el resto del registro.
  const editMangaDetails = (manga) => {
    $f7.dialog.prompt(
      'Ingrese el nombre del autor:',
      'Editar ficha',
      (authorValue) => {
        const author = authorValue.trim();

        if (!author) {
          $f7.dialog.alert('El autor no puede quedar vacío.');
          return;
        }

        $f7.dialog.prompt(
          'Ingrese el género del manga:',
          'Editar ficha',
          (genreValue) => {
            const genre = genreValue.trim();

            if (!genre) {
              $f7.dialog.alert('El género no puede quedar vacío.');
              return;
            }

            $f7.dialog.prompt(
              'Ingrese la sinopsis del manga:',
              'Editar ficha',
              (synopsisValue) => {
                const synopsis = synopsisValue.trim();

                if (synopsis.length > 500) {
                  $f7.dialog.alert('La sinopsis no puede superar los 500 caracteres.');
                  return;
                }

                // Actualiza solamente los datos descriptivos del manga.
                const updated = updateManga(manga.id, {
                  author,
                  genre,
                  synopsis
                });

                if (updated) {
                  refreshMangas();
                  $f7.dialog.alert('La ficha del manga se actualizó correctamente.');
                } else {
                  $f7.dialog.alert('No se pudo encontrar el manga.');
                }
              },
              null,
              manga.synopsis || ''
            );
          },
          null,
          manga.genre || ''
        );
      },
      null,
      manga.author || ''
    );
  };

  // Permite cambiar el capítulo actual de un manga.
  const editChapter = (manga) => {
    $f7.dialog.prompt(
      'Ingrese el nuevo capítulo:',
      'Editar capítulo',
      (value) => {
        if (!value || !value.trim()) {
          $f7.dialog.alert('Ingrese un capítulo válido.');
          return;
        }

        updateManga(manga.id, {
          chapter: value.trim()
        });

        refreshMangas();
      }
    );
  };

  // Muestra las opciones para cambiar el estado de lectura.
  const changeStatus = (manga) => {
    $f7.dialog.create({
      title: 'Cambiar estado',
      text: 'Seleccione el nuevo estado del manga:',
      buttons: [
        {
          text: 'Pendiente',
          onClick: () => {
            updateManga(manga.id, { status: 'Pendiente' });
            refreshMangas();
          }
        },
        {
          text: 'Leyendo',
          onClick: () => {
            updateManga(manga.id, { status: 'Leyendo' });
            refreshMangas();
          }
        },
        {
          text: 'Completado',
          onClick: () => {
            updateManga(manga.id, { status: 'Completado' });
            refreshMangas();
          }
        }
      ]
    }).open();
  };

  // Pide confirmación antes de eliminar un manga de la biblioteca.
  const removeManga = (manga) => {
    $f7.dialog.create({
      title: 'Eliminar manga',
      text: `¿Está seguro de que desea eliminar "${manga.title}" de su biblioteca?`,
      buttons: [
        {
          text: 'Cancelar'
        },
        {
          text: 'Eliminar',
          onClick: () => {
            const deleted = deleteManga(manga.id);

            if (deleted) {
              if (expandedMangaId === manga.id) {
                expandedMangaId = null;
              }
              refreshMangas();
            } else {
              $f7.dialog.alert('No se pudo encontrar el manga.');
            }
          }
        }
      ]
    }).open();
  };

  // Actualiza los datos cada vez que el usuario vuelve a esta pantalla.
  $on('pageBeforeIn', refreshMangas);

  return $render;
};
</script>

