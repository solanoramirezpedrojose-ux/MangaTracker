<template>
  <div class="page" data-name="home">
    <div class="navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="title">MangaTracker</div>
      </div>
    </div>

    <div class="page-content">
      <div class="block">
        <h1>Mi biblioteca</h1>
        <p>Organizá y llevá el control de tus mangas.</p>
      </div>

      <div class="block">
        <h2>Mis mangas</h2>
      </div>

      <div class="list media-list inset">
        <ul>
          ${
            mangas.length === 0
              ? $h`
                <li>
                  <div class="item-content">
                    <div class="item-inner">
                      <div class="item-title">Tu biblioteca está vacía</div>
                      <div class="item-text">
                        Agregá un manga para comenzar.
                      </div>
                    </div>
                  </div>
                </li>
              `
              : mangas.map((manga) => $h`
                <li>
                  <div class="item-content">
                    <div class="item-inner">
                      <div class="item-title">${manga.title}</div>

                      <div class="item-subtitle">
                        Capítulo actual: ${manga.chapter}
                      </div>

                      <div class="item-text">
                        Estado: ${manga.status}
                      </div>

                      <div class="row">
                        <div class="col-50">
                          <button
                            type="button"
                            class="button button-fill button-small"
                            @click="${() => editChapter(manga)}"
                          >
                            Editar capítulo
                          </button>
                        </div>

                        <div class="col-50">
                          <button
                            type="button"
                            class="button button-outline button-small"
                            @click="${() => changeStatus(manga)}"
                          >
                            Cambiar estado
                          </button>
                        </div>
                      </div>

                      <div class="block">
                        <button
                          type="button"
                          class="button button-outline button-small"
                          @click="${() => removeManga(manga)}"
                        >
                          Eliminar manga
                        </button>
                      </div>
                    </div>
                  </div>
                </li>
              `)
          }
        </ul>
      </div>

      <div class="block">
        <a href="/add-manga/" class="button button-fill button-round">
          Agregar manga
        </a>
      </div>
    </div>
  </div>
</template>

<script>
import {
  getMangas,
  updateManga,
  deleteManga
} from '../js/manga-storage.js';

export default (props, { $f7, $update, $on }) => {
  let mangas = getMangas();

  const refreshMangas = () => {
    mangas = getMangas();
    $update();
  };

  const editChapter = (manga) => {
    $f7.dialog.prompt(
      'Ingrese el nuevo capítulo:',
      'Editar capítulo',
      (value) => {
        if (!value || !value.trim()) {
          $f7.dialog.alert('Ingrese un capítulo válido.');
          return;
        }

        updateManga(manga.id, {
          chapter: value.trim()
        });

        refreshMangas();
      }
    );
  };

  const changeStatus = (manga) => {
    $f7.dialog.create({
      title: 'Cambiar estado',
      text: 'Seleccione el nuevo estado del manga:',
      buttons: [
        {
          text: 'Pendiente',
          onClick: () => {
            updateManga(manga.id, { status: 'Pendiente' });
            refreshMangas();
          }
        },
        {
          text: 'Leyendo',
          onClick: () => {
            updateManga(manga.id, { status: 'Leyendo' });
            refreshMangas();
          }
        },
        {
          text: 'Completado',
          onClick: () => {
            updateManga(manga.id, { status: 'Completado' });
            refreshMangas();
          }
        }
      ]
    }).open();
  };

  const removeManga = (manga) => {
    $f7.dialog.create({
      title: 'Eliminar manga',
      text: `¿Está seguro de que desea eliminar "${manga.title}" de su biblioteca?`,
      buttons: [
        {
          text: 'Cancelar'
        },
        {
          text: 'Eliminar',
          onClick: () => {
            const deleted = deleteManga(manga.id);

            if (deleted) {
              refreshMangas();
            } else {
              $f7.dialog.alert('No se pudo encontrar el manga.');
            }
          }
        }
      ]
    }).open();
  };

  $on('pageBeforeIn', refreshMangas);

  return $render;
};
</script>