<template>
  <div class="page mt-page" data-name="home">

    <div class="navbar mt-navbar">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="mt-brand">
          <span class="mt-logo">M</span>
          <span>MangaTracker</span>
        </div>
        <div class="mt-navbar-label">MY READING SPACE</div>
      </div>
    </div>

    <div class="page-content mt-content">
      <div class="mt-container">

        <section class="mt-welcome">
          <div>
            <div class="mt-eyebrow">TU BIBLIOTECA PERSONAL</div>
            <h1>Mi colección</h1>
            <p>Organizá tus lecturas y llevá el control de tus mangas.</p>
          </div>

          <a href="/add-manga/" class="button mt-add-button">
            <span class="mt-plus">+</span>
            Agregar manga
          </a>
        </section>

        <section class="mt-stats">
          <div class="mt-stat-card">
            <span class="mt-stat-label">TOTAL DE MANGAS</span>
            <strong>${mangas.length}</strong>
            <span class="mt-stat-detail">En tu biblioteca</span>
          </div>

          <div class="mt-stat-card">
            <span class="mt-stat-label">LEYENDO</span>
            <strong>${mangas.filter(manga => manga.status === 'Leyendo').length}</strong>
            <span class="mt-stat-detail">Lecturas activas</span>
          </div>

          <div class="mt-stat-card">
            <span class="mt-stat-label">COMPLETADOS</span>
            <strong>${mangas.filter(manga => manga.status === 'Completado').length}</strong>
            <span class="mt-stat-detail">Historias terminadas</span>
          </div>
        </section>

        <section class="mt-library">
          <div class="mt-section-heading">
            <div>
              <h2>Mis mangas</h2>
              <p>Tu colección personal</p>
            </div>
            <span class="mt-total">${mangas.length} registros</span>
          </div>

          <div class="mt-manga-grid">
            ${
              mangas.length === 0
                ? $h`
                  <div class="mt-empty">
                    <div class="mt-empty-symbol">M</div>
                    <h3>Tu biblioteca está vacía</h3>
                    <p>Agregá tu primer manga para comenzar.</p>
                  </div>
                `
                : mangas.map((manga) => $h`
                  <article class="mt-card">
                    ${
                      (manga.title || '').trim().toLowerCase() === 'one piece'
                        ? $h`
                          <div class="mt-cover mt-cover-image">
                            <img
                              src="/images/one-piece-vol1.jpg"
                              alt="Portada de One Piece, volumen 1"
                            />
                          </div>
                        `
                        : $h`
                          <div class="mt-cover">
                            <span class="mt-cover-top">MANGATRACKER</span>
                            <span class="mt-cover-initial">
                              ${manga.title ? manga.title.charAt(0).toUpperCase() : 'M'}
                            </span>
                            <span class="mt-cover-bottom">MY COLLECTION</span>
                          </div>
                        `
                    }

                    <div class="mt-card-info">
                      <div class="mt-card-title">${manga.title}</div>

                      <div class="mt-chapter">
                        Capítulo actual: <strong>${manga.chapter}</strong>
                      </div>

                      <span class="mt-status ${
                        manga.status === 'Leyendo'
                          ? 'is-reading'
                          : manga.status === 'Completado'
                            ? 'is-completed'
                            : 'is-pending'
                      }">
                        ${manga.status}
                      </span>

                      <div class="mt-card-actions">
                        <button
                          type="button"
                          class="button mt-action-button"
                          @click="${() => editChapter(manga)}"
                        >
                          Editar capítulo
                        </button>

                        <button
                          type="button"
                          class="button mt-action-button"
                          @click="${() => changeStatus(manga)}"
                        >
                          Cambiar estado
                        </button>

                        <button
                          type="button"
                          class="button mt-delete-button"
                          @click="${() => removeManga(manga)}"
                        >
                          Eliminar
                        </button>
                      </div>
                    </div>
                  </article>
                `)
            }
          </div>
        </section>

      </div>
    </div>
  </div>
</template>

<script>
import {
  getMangas,
  updateManga,
  deleteManga
} from '../js/manga-storage.js';

export default (props, { $f7, $update, $on }) => {
  let mangas = getMangas();

  const refreshMangas = () => {
    mangas = getMangas();
    $update();
  };

  const editChapter = (manga) => {
    $f7.dialog.prompt(
      'Ingrese el nuevo capítulo:',
      'Editar capítulo',
      (value) => {
        if (!value || !value.trim()) {
          $f7.dialog.alert('Ingrese un capítulo válido.');
          return;
        }

        updateManga(manga.id, {
          chapter: value.trim()
        });

        refreshMangas();
      }
    );
  };

  const changeStatus = (manga) => {
    $f7.dialog.create({
      title: 'Cambiar estado',
      text: 'Seleccione el nuevo estado del manga:',
      buttons: [
        {
          text: 'Pendiente',
          onClick: () => {
            updateManga(manga.id, { status: 'Pendiente' });
            refreshMangas();
          }
        },
        {
          text: 'Leyendo',
          onClick: () => {
            updateManga(manga.id, { status: 'Leyendo' });
            refreshMangas();
          }
        },
        {
          text: 'Completado',
          onClick: () => {
            updateManga(manga.id, { status: 'Completado' });
            refreshMangas();
          }
        }
      ]
    }).open();
  };

  const removeManga = (manga) => {
    $f7.dialog.create({
      title: 'Eliminar manga',
      text: `¿Está seguro de que desea eliminar "${manga.title}" de su biblioteca?`,
      buttons: [
        {
          text: 'Cancelar'
        },
        {
          text: 'Eliminar',
          onClick: () => {
            const deleted = deleteManga(manga.id);

            if (deleted) {
              refreshMangas();
            } else {
              $f7.dialog.alert('No se pudo encontrar el manga.');
            }
          }
        }
      ]
    }).open();
  };

  $on('pageBeforeIn', refreshMangas);

  return $render;
};
</script>

